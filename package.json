{
  "name": "inventory-depletion",
  "version": "1.0.0",
  "description": "Deducts inventory by recipe from Loyverse sales and alerts over WhatsApp before a stockout",
  "type": "module",
  "main": "scheduler.js",
  "scripts": {
    "start": "node scheduler.js",
    "depletion": "node -e \"import('./depletion.js').then(m => m.runDepletion())\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1"
  }
}
